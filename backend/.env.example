TUSHARE_TOKEN=your_tushare_pro_token_here
DATABASE_URL=postgresql+asyncpg://astock:astock@localhost:5432/astock
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Risk-free rate fallback (only used when Tushare macro data unavailable)
DEFAULT_RISK_FREE_RATE=0.025
# ERP default for A-shares
DEFAULT_ERP=0.065
# Default WACC when computation not possible
DEFAULT_WACC_STABLE=0.09
DEFAULT_WACC_CYCLICAL=0.10
DEFAULT_WACC_HIGH_RISK=0.11
