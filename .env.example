# Optional: override frontend proxy URL. By default frontend uses /api/tushare/proxy.
# VITE_TUSHARE_PROXY_URL=http://localhost:8787/api/tushare/proxy

# Node proxy settings
TUSHARE_PROXY_PORT=8787
TUSHARE_UPSTREAM_URL=https://api.tushare.pro
# Recommended: set token on server side so frontend token input can stay empty.
TUSHARE_TOKEN=
