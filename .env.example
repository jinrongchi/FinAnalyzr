# Optional: override frontend proxy URL. 
# By default frontend uses /api/tushare/proxy.
VITE_TUSHARE_PROXY_URL=http://localhost:8787/api/tushare/proxy

# Frontend browser storage options
# By default, the app uses localStorage to persist user settings and data across sessions.
# local = localStorage (persistent), session = sessionStorage (tab session only)
VITE_STORAGE_DRIVER=local
# Use namespace to isolate keys across environments/apps.
VITE_STORAGE_NAMESPACE=finanalyzr

# Node proxy settings
TUSHARE_PROXY_PORT=8787
TUSHARE_UPSTREAM_URL=https://api.tushare.pro
# Set token on server side so frontend token input can stay empty.
TUSHARE_TOKEN=
